{
  "name": "mcp-postgres",
  "version": "1.1.0",
  "description": "PostgreSQL MCP server for bbdump: read-only exploration and queries, plus writes confirmed by the user in the bbdump app",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "mcp-postgres": "./build/index.js"
  },
  "scripts": {
    "prebuild": "node ../scripts/copy-mcp-shared.mjs",
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "mongodb": "7.7.0",
    "mssql": "12.7.9",
    "mysql2": "^3.24.6",
    "pg": "^8.16.3",
    "pg-format": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.2",
    "@types/pg-format": "^1.0.5",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@azure/identity": "4.13.0"
  }
}
