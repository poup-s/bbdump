{
  "name": "bbdump",
  "version": "1.8.3",
  "description": "Cross-platform PostgreSQL backup manager with automated scheduling, encryption, and modern UI",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && npm run build:renderer",
    "build:renderer": "vite build",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dmg": "npm run build && electron-builder --mac dmg",
    "dmg:universal": "npm run build && electron-builder --mac --universal dmg",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --mac --win --linux",
    "start": "electron ."
  },
  "keywords": [
    "electron",
    "postgresql",
    "backup",
    "pg_dump",
    "database",
    "automation",
    "cron",
    "encryption",
    "cross-platform",
    "bbdump"
  ],
  "author": "Poups <your-email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poup-s/bbdump.git"
  },
  "bugs": {
    "url": "https://github.com/poup-s/bbdump/issues"
  },
  "homepage": "https://github.com/poup-s/bbdump#readme",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg-format": "^1.0.5",
    "@vitejs/plugin-vue": "^6.0.2",
    "autoprefixer": "^10.4.22",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  },
  "dependencies": {
    "@tresjs/cientos": "^5.1.1",
    "@tresjs/core": "^5.1.1",
    "@types/pg": "^8.15.6",
    "@vueuse/core": "^14.0.0",
    "@vueuse/motion": "^3.0.3",
    "node-cron": "^3.0.3",
    "pg": "^8.16.3",
    "pg-format": "^1.0.4",
    "three": "^0.181.2",
    "vue": "^3.5.24"
  },
  "build": {
    "appId": "com.bbdump.app",
    "productName": "bbdump",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "config.json",
      "backups/**/*",
      "logs/**/*",
      "logo.png"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "logo.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": null,
      "entitlementsInherit": null,
      "type": "distribution"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logo.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "logo.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
